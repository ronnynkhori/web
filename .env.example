# Games Control Room configuration.
# Copy to .env.local for local work. On Vercel, add Supabase from the Vercel
# Marketplace (Storage > Supabase): it sets the SUPABASE_* variables for you.

# --- Public address ---
# Set once a custom domain is live, e.g. https://maputo2026.org. Defaults to
# the Vercel production address. Used for search-engine language links.
NEXT_PUBLIC_SITE_URL=
# "1" at launch lets search engines index the site (robots.txt + meta robots).
# Anything else, and every preview deployment, stays noindex.
SITE_PUBLIC=

# --- Supabase (database, logins, file storage) ---
# Without these the Control Room uses a local file (.data/store.json), which
# works on your machine but is read-only on Vercel.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Control Room sign-in ---
# 32+ random characters. Required in production.
ADMIN_SESSION_SECRET=
# First super admin. Used only until a super admin exists in Control Room > Users.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Live results ---
# "store" = scores from the Control Room, "demo" = simulated feed.
# Leave empty to use the Control Room once matches or results have been saved.
RESULTS_PROVIDER=
# Simulated scores. Empty = shown read-only and labelled DEMO, never copied into
# the production database (local dev still copies them for testing).
# "0" = no demo anywhere (set this before the Games). "1" = copy into the database
# (pitch environments only; clear them in Settings > Clear demo results).
DEMO_DATA=

# --- Scheduled publishing (Vercel Cron) ---
# Vercel sends this as a Bearer token to /api/cron/publish.
CRON_SECRET=

# --- Monitoring ---
# Optional. Server errors always go to Vercel's runtime logs; set a Slack or
# Teams incoming-webhook URL to also be pinged when one happens.
ERROR_WEBHOOK_URL=
